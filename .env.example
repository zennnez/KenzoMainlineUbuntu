# ==============================================================================
# Xiaomi Redmi Note 3 Pro (Kenzo / MSM8956) - Build & Runtime Configuration
# ==============================================================================

# User Account Settings
KENZO_USER=kenzo
KENZO_USER_PASSWORD=password
KENZO_ROOT_PASSWORD=password
# KENZO_SSH_PUBKEY="ssh-ed25519 AAAAC... user@example.com"
KENZO_SSH_PUBKEY=

# Container Runtime Optimization:
# When SKIP_DOCKER=true, skips installing Docker, containerd, and docker-compose to save ~400MB disk/RAM.
SKIP_DOCKER=true

# Subsystem Optimization: Skip Broken / Incomplete Subsystems
# Set master toggle or fine-tune individually:
SKIP_BROKEN=true

# Touchscreen (FT5426 / Atmel MaxTouch):
# When SKIP_TOUCH=true, disables touch nodes in DTB and touch drivers in kernel.
# Eliminates 15 probe retries and I2C -6 errors during boot; recommended for server mode.
SKIP_TOUCH=true

# Venus Hardware Video Codec (VPU):
# When SKIP_VENUS=true, skips broken Venus kernel modules and removes firmware blobs (saves ~10MB).
SKIP_VENUS=true

# Audio & Sound (Hexagon LPASS ADSP + SLIMbus):
# When SKIP_AUDIO=true (or DISABLE_ADSP=true), disables ADSP remoteproc and SLIMbus controller in DTB.
# Eliminates the 8-second QMI wait timeout and QRTR error -12; saves 16MB RAM.
SKIP_AUDIO=true
DISABLE_ADSP=true

# Cellular Baseband & Modem:
# When SKIP_CELLULAR=true, excludes ModemManager and libqmi/mbim from rootfs and masks service.
# Saves ~21MB RAM and stops background serial polling.
SKIP_CELLULAR=true

# Bluetooth (optional for headless server mode):
# Set to true to mask bluetooth.service and mpris-proxy (saves ~10MB RAM).
SKIP_BLUETOOTH=false

# Hostname & Timezone
KENZO_HOSTNAME=kenzo
TIMEZONE=UTC

# USB RNDIS Gadget Networking
KENZO_IP=192.168.7.2
KENZO_HOST_IP=192.168.7.1

# Optional Wi-Fi Autoconnect Credentials (leave empty if configuring on-device via nmtui / kenzo-wifi)
# Format as a JSON dictionary:
#   KENZO_WIFI_NETWORKS='{"Home_5G": "secret123", "Work_WiFi": "office_pass"}'
# Or as key:value pairs:
#   KENZO_WIFI_NETWORKS="Home_5G:secret123, Work_WiFi:office_pass"
KENZO_WIFI_NETWORKS='{
  "SSID": "password",
  "SSID_5G": "password"
}'
# Legacy single SSID/password (fallback if KENZO_WIFI_NETWORKS is empty)
KENZO_WIFI_SSID=
KENZO_WIFI_PASSWORD=

# Battery Management & USB Pass-Through (24/7 Server Mode)
# Caps battery charging at STOP_THRESHOLD (%) instead of 100%.
# Resumes charging when battery drops to START_THRESHOLD (%).
BATTERY_STOP_THRESHOLD=60
BATTERY_START_THRESHOLD=58
BATTERY_CHECK_INTERVAL_SEC=30

# Distribution & Build Parameters
SUITE=resolute
MIRROR=http://ports.ubuntu.com/ubuntu-ports
KERNEL_SRC=~/msm8956-mainline-linux

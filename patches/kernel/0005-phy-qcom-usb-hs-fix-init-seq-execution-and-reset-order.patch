From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antigravity <antigravity@google.com>
Date: Fri, 16 Oct 2026 16:47:00 +0530
Subject: [PATCH] phy: qcom-usb-hs: fix init-seq loop termination and reset order

1. When qcom,init-seq begins with register offset 0x00, checking
   seq->addr evaluates to false on the first entry, causing the loop
   to terminate immediately without programming any ULPI vendor registers.
   Store init_seq_num explicitly and loop by count.
2. In qcom_usb_hs_phy_power_on(), reset_control_reset(por) was called
   after writing init_seq, clearing the programmed vendor tuning registers.
   Move reset before writing init_seq so calibration registers persist.

Signed-off-by: Antigravity <antigravity@google.com>
---
 drivers/phy/qualcomm/phy-qcom-usb-hs.c | 23 +++++++++++++----------
 1 file changed, 13 insertions(+), 10 deletions(-)

diff --git a/drivers/phy/qualcomm/phy-qcom-usb-hs.c b/drivers/phy/qualcomm/phy-qcom-usb-hs.c
index 98a18987f1be..b0f734b16b67 100644
--- a/drivers/phy/qualcomm/phy-qcom-usb-hs.c
+++ b/drivers/phy/qualcomm/phy-qcom-usb-hs.c
@@ -35,6 +35,7 @@ struct qcom_usb_hs_phy {
 	struct regulator *v3p3;
 	struct reset_control *reset;
 	struct ulpi_seq *init_seq;
+	unsigned int init_seq_num;
 	struct extcon_dev *vbus_edev;
 	struct notifier_block vbus_notify;
 };
@@ -110,7 +111,7 @@ static int qcom_usb_hs_phy_power_on(struct phy *phy)
 	struct qcom_usb_hs_phy *uphy = phy_get_drvdata(phy);
 	struct ulpi *ulpi = uphy->ulpi;
 	const struct ulpi_seq *seq;
-	int ret, state;
+	int ret, state, i;
 
 	ret = clk_prepare_enable(uphy->ref_clk);
 	if (ret)
@@ -141,15 +142,16 @@ static int qcom_usb_hs_phy_power_on(struct phy *phy)
 	if (ret)
 		goto err_3p3;
 
-	for (seq = uphy->init_seq; seq->addr; seq++) {
-		ret = ulpi_write(ulpi, ULPI_EXT_VENDOR_SPECIFIC + seq->addr,
-				 seq->val);
+
+	if (uphy->reset) {
+		ret = reset_control_reset(uphy->reset);
 		if (ret)
 			goto err_ulpi;
 	}
 
-	if (uphy->reset) {
-		ret = reset_control_reset(uphy->reset);
+	for (i = 0; i < uphy->init_seq_num; i++) {
+		ret = ulpi_write(ulpi, ULPI_EXT_VENDOR_SPECIFIC + uphy->init_seq[i].addr,
+				 uphy->init_seq[i].val);
 		if (ret)
 			goto err_ulpi;
 	}
@@ -218,16 +220,17 @@ static int qcom_usb_hs_phy_probe(struct ulpi *ulpi)
 	size = of_property_count_u8_elems(ulpi->dev.of_node, "qcom,init-seq");
 	if (size < 0)
 		size = 0;
-	uphy->init_seq = devm_kmalloc_array(&ulpi->dev, (size / 2) + 1,
-					   sizeof(*uphy->init_seq), GFP_KERNEL);
-	if (!uphy->init_seq)
-		return -ENOMEM;
-	ret = of_property_read_u8_array(ulpi->dev.of_node, "qcom,init-seq",
-					(u8 *)uphy->init_seq, size);
-	if (ret && size)
-		return ret;
-	/* NUL terminate */
-	uphy->init_seq[size / 2].addr = uphy->init_seq[size / 2].val = 0;
+	uphy->init_seq_num = size / 2;
+	if (uphy->init_seq_num) {
+		uphy->init_seq = devm_kmalloc_array(&ulpi->dev, uphy->init_seq_num,
+						   sizeof(*uphy->init_seq), GFP_KERNEL);
+		if (!uphy->init_seq)
+			return -ENOMEM;
+		ret = of_property_read_u8_array(ulpi->dev.of_node, "qcom,init-seq",
+						(u8 *)uphy->init_seq, size);
+		if (ret)
+			return ret;
+	}
 
 	uphy->ref_clk = clk = devm_clk_get(&ulpi->dev, "ref");
 	if (IS_ERR(clk))

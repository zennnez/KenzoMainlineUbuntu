--- a/arch/arm64/boot/dts/qcom/msm8976.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8976.dtsi
@@ -2190,7 +2190,9 @@
 		compatible = "qcom,msm8976-adsp-pil";
 		reg = <0x0c200000 0x100>;
 
-		interrupts-extended = <&intc GIC_SPI 289 IRQ_TYPE_EDGE_RISING>,
+		/* wdog is SPI 293 (as on msm8953). 289 is the SMD edge interrupt below: using it here made every SMD
+		 * message from the ADSP look like a watchdog bite -> endless "crash detected in adsp: type watchdog" loop. */
+		interrupts-extended = <&intc GIC_SPI 293 IRQ_TYPE_EDGE_RISING>,
 				      <&adsp_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
 				      <&adsp_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
 				      <&adsp_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,

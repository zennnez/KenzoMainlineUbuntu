# Wi-Fi + Bluetooth on the WCNSS (Pronto/Riva) block: wcn36xx (WCN3660/3680) + btqcomsmd.
# Everything here is a MODULE on purpose: the wcnss remoteproc needs signed firmware from /lib/firmware, which only
# exists after the rootfs is mounted. Built-in drivers would probe from the initramfs stage, fail the firmware load
# and sit there for ~60 s. udev loads the modules from the rootfs instead.
CONFIG_RFKILL=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH_COMMON=m
CONFIG_WCN36XX=m
CONFIG_REMOTEPROC=y
CONFIG_REMOTEPROC_QCOM_COMMON=m
CONFIG_REMOTEPROC_QCOM_PIL_INFO=m
CONFIG_QCOM_WCNSS_PIL=m
CONFIG_QCOM_WCNSS_CTRL=m
CONFIG_QCOM_MDT_LOADER=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK=n
CONFIG_RPMSG_QCOM_GLINK_SMEM=n
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y

# ARC4 crypto needed by mac80211 + wcn36xx (libarc4.ko)
CONFIG_CRYPTO_LIB_ARC4=m
CONFIG_CRYPTO_ARC4=y

# Bluetooth over the same chip (HCI via rpmsg), plus what a wireless keyboard needs
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m
CONFIG_BT_QCA=m
CONFIG_BT_QCOMSMD=m
CONFIG_UHID=m
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=m

# kenzo modem partition (firmware source) is FAT
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# firmware-loader + zstd compressed modules
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_ZSTD_DECOMPRESS=y
# Applied on top of arch/arm64/configs/msm8956_defconfig.
# No /lib/modules on first boot -> everything needed to reach SSH is built in (=y).
# Source for each of these was =m in msm8956_defconfig.

# eMMC / rootfs
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Display: MDP5 + DSI + panel + WLED backlight
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_MSM8956_GENERATED=y
CONFIG_DRM_PANEL_XIAOMI_KENZO_NT35532_BOE=y
CONFIG_DRM_PANEL_XIAOMI_KENZO_NT35596_TIANMA=y
CONFIG_DRM_PANEL_XIAOMI_KENZO_R63315_SHARP=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# USB gadget RNDIS (chipidea @ 78db000)
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_MSM=y
CONFIG_PHY_QCOM_USB_HS=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_RNDIS=y
CONFIG_CONFIGFS_FS=y

# Touch (kenzo has both FocalTech + Atmel nodes in DTS)
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_TOUCHSCREEN_ATMEL_MXT=y

# Charger / fuel gauge on pmi8950
CONFIG_CHARGER_QCOM_SMBCHG=y

# Debug: keep last-kmsg across reboot (DTS has ramoops @ 0xdfc00000)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_MAGIC_SYSRQ=y

# Docker etc. can be added later; Ubuntu's systemd needs these:
CONFIG_CGROUPS=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SECCOMP=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y

# TrustZone / QSEECOM security interface
CONFIG_QCOM_QSEECOM=y

# ZRAM compressed in-memory swap with ZSTD
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_DEF_COMP="zstd"
